# Copy this file to .env and fill values before running the server
# Required for Google GenAI (Gemini) access
GOOGLE_GENAI_API_KEY=your_google_genai_api_key_here

# MongoDB connection string, e.g. mongodb://localhost:27017/interview-ai
MONGO_URI=your_mongo_connection_string_here

# JWT secret for auth token signing
JWT_SECRET=your_jwt_secret_here

# Optional: set to true to use a mock AI implementation (not implemented by default)
MOCK_AI=false
